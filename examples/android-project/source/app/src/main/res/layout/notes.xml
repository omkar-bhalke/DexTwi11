<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="@dimen/gutter"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <ImageView android:id="@+id/icon" android:src="@drawable/note" android:contentDescription="@string/app_name"
        android:layout_width="32dp" android:layout_height="32dp"/>
    <TextView android:id="@+id/title" android:text="@string/app_name" android:textSize="28sp" android:textStyle="bold"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/draft" android:hint="@string/prompt" android:inputType="textMultiLine"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/save" android:text="@string/save" android:onClick="saveDraft"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
